{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "0.5.0",
  "default_locale": "en",
  "description": "__MSG_app_desc__",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "nativeMessaging",
    "debugger",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Bridge"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
